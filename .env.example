# credentials of the app registered on https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# redirect uri in the spotify dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# protects /login, /callback, /flush e /api/covers/refresh
# If you leave it blank, one is generated upon the first startup and saved in the database,
# and the full login URL appears in the logs
ADMIN_TOKEN=

# db sqlLite
DATABASE_PATH=data/lifetime.db

# seconds between a poll and the other of /me/player/currently-playing
POLL_INTERVAL=15

# frazione della durata da ascoltare davvero perché il brano venga salvato
PLAY_THRESHOLD=0.75

# nome delle playlist generate, {year} obbligatorio
PLAYLIST_NAME_TEMPLATE=Lifetime {year}

# true = playlist pubbliche, false = private
PLAYLIST_PUBLIC=false

# copertina generata e caricata su spotify per ogni playlist dell'anno
# (richiede lo scope ugc-image-upload: se il token è più vecchio, rifare /login)
PLAYLIST_COVERS=true

# host/porta del server
HOST=0.0.0.0
PORT=8000

# origini ammesse dalla spa angular, separate da virgola
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ascolti più brevi di così non finiscono nemmeno nello storico
MIN_PLAY_MS=5000

# fuso orario del container: giorni della heatmap, fasce orarie e anno delle
# playlist sono calcolati in ora locale
TZ=Europe/Rome
